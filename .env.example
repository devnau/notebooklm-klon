# ════════════════════════════════════════════════════════════════════════════
# Vorlage. Echte Werte gehören in eine .env, die NICHT im Repo liegt.
#
# Schnellstart:  node scripts/generate-secrets.mjs > .env
# Danach nur noch ANTHROPIC_API_KEY und VOYAGE_API_KEY ergänzen.
#
# Auf dem Server:  chmod 600 .env
# ════════════════════════════════════════════════════════════════════════════

# ── Datenbank ───────────────────────────────────────────────────────────────
# Wird für postgres, supabase_auth_admin und supabase_storage_admin verwendet.
POSTGRES_PASSWORD=REPLACE_ME
# Nur an 127.0.0.1 gebunden; im Produktionsbetrieb gar nicht veröffentlicht.
POSTGRES_PORT=54322

# ── JWT ─────────────────────────────────────────────────────────────────────
# Gemeinsames Geheimnis von GoTrue, PostgREST und Storage. Mindestens 32 Zeichen.
JWT_SECRET=REPLACE_ME

# Signierte HS256-JWTs mit dem Claim `role`, nicht beliebige Zufallsstrings.
# Passend zum JWT_SECRET generieren: node scripts/generate-secrets.mjs
#
# anon:         öffentlich, landet im Browser-Bundle, unterliegt voll der RLS.
# service_role: umgeht RLS komplett. Nur serverseitig (Worker, Route Handler),
#               niemals in einer NEXT_PUBLIC_-Variable.
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# ── URLs ────────────────────────────────────────────────────────────────────
# Gateway (Auth/REST/Storage unter einer Origin) und die App selbst.
PUBLIC_GATEWAY_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000
GATEWAY_PORT=8000
MAILPIT_UI_PORT=8025

# ── Verhalten ───────────────────────────────────────────────────────────────
# In Produktion auf true setzen, sobald die gewünschten Nutzer angelegt sind.
DISABLE_SIGNUP=false
# Im Dev-Betrieb true (Mails landen in Mailpit); in Produktion false.
MAILER_AUTOCONFIRM=true
LOG_LEVEL=info

# ── SMTP (Produktion) ───────────────────────────────────────────────────────
# Im Dev-Betrieb nicht nötig, dann greift Mailpit.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=noreply@example.com
# SMTP_SENDER_NAME=Notebook Studio

# ── Externe Dienste ─────────────────────────────────────────────────────────
# Anthropic für Chat und Artefakte.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Voyage AI für Embeddings (Anthropic bietet keine Embeddings an).
VOYAGE_API_KEY=REPLACE_ME
