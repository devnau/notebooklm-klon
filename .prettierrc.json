{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 92,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.md",
      "options": { "proseWrap": "preserve" }
    },
    {
      "files": "*.sql",
      "options": { "keywordCase": "lower" }
    }
  ]
}
