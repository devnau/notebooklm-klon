{
  "name": "@nlm/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verarbeitet langlaufende Jobs: Quellen-Import, Artefakte, Audio.",
  "scripts": {
    "prestart": "npm --prefix ../.. run build --workspace=@nlm/shared",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "predev": "npm --prefix ../.. run build --workspace=@nlm/shared",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@mozilla/readability": "^0.6.0",
    "@nlm/shared": "*",
    "@supabase/supabase-js": "^2.110.8",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.0",
    "pino": "^10.3.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.1"
  }
}
