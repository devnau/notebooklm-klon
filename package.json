{
  "name": "notebooklm-klon",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted NotebookLM-Klon: grounded RAG-Chat mit klickbaren Zitaten, Studio-Artefakten und Audio-Overview.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@nlm/web",
    "build": "npm run build --workspace=@nlm/shared && npm run build --workspace=@nlm/web",
    "start": "npm run start --workspace=@nlm/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --force && tsc --noEmit -p packages/shared && tsc --noEmit -p apps/web && tsc --noEmit -p apps/worker && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "db:types": "bash scripts/gen-db-types.sh",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "start:standalone": "bash scripts/start-standalone.sh",
    "cleanup:probe": "node scripts/cleanup-probe.mjs",
    "backup": "bash scripts/backup.sh",
    "restore:probe": "bash scripts/restore-probe.sh",
    "rag:e2e": "node scripts/rag-e2e.mjs",
    "ingest:e2e": "node scripts/ingest-e2e.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "predev": "npm run build --workspace=@nlm/shared",
    "pretest": "npm run build --workspace=@nlm/shared",
    "pretest:e2e": "npm run build --workspace=@nlm/shared",
    "verify:fresh": "bash scripts/verify-fresh-checkout.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.3"
    },
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
